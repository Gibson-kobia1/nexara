# Supabase Configuration (Required for API Routes on Vercel)
# These are server-side environment variables needed by the /api routes
SUPABASE_URL="https://your-project-url.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Frontend Supabase Configuration
# These are client-side variables prefixed with VITE_ for Vite
VITE_SUPABASE_URL="https://your-project-url.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Build Optimization
# Required for production builds to prevent out-of-memory errors
NODE_OPTIONS="--max-old-space-size=4096"

# Google OAuth (Optional - for Google Sign-In)
VITE_GOOGLE_CLIENT_ID="your-google-client-id"

# Firebase Configuration (Optional - for Apple Sign-In)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Note: When deploying to Vercel, set these in Project Settings > Environment Variables
# - Server-side variables (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, NODE_OPTIONS) are used during build and runtime
# - Client-side variables (VITE_*) are embedded into the frontend bundle
